// The portal's relay (src/index.ts). No account ids or secrets here: `wrangler login` holds the account,
// and the owner's admin token is a secret (`wrangler secret put ADMIN_TOKEN`; locally, .dev.vars).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay", // (relay.ghillie.workers.dev: Jace's subdomain, ghillie; 11/06/2026)
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "CHANNEL", "class_name": "Channel" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      // the aether (11/07/2026, src/aether.ts): one room for every outstation and visitor, one object for the relay
      { "name": "AETHER", "class_name": "Aether" }
    ]
  },
  // the clips on players' Outside pages (src/clips.ts): made once with `npx wrangler r2 bucket create outside-clips`
  "r2_buckets": [
    { "binding": "CLIPS", "bucket_name": "outside-clips" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Channel", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["Aether"] }
  ],
  "vars": {
    "MAX_VIEWERS": "0",
    // the oldest client let in ("" lets every version in): raise it when the protocol changes in a way older
    // clients can't follow; they're told to get a newer one (4026) instead of trying again
    "MIN_CLIENT": ""
  },
  // (11/07/2026: every message a transmitting outstation sends is an invocation, and each was logged: an hour or two
  // at 60 a second used the free plan's whole day of logs. One in a hundred is plenty to look into a fault.)
  "observability": { "enabled": true, "head_sampling_rate": 0.01 }
}
