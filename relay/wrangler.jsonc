// The portal's relay (src/index.ts). No account ids or secrets here: `wrangler login` holds the account,
// and the owner's admin token is a secret (`wrangler secret put ADMIN_TOKEN`; locally, .dev.vars).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay", // (relay.ghillie.workers.dev: Jace's subdomain, ghillie; 11/06/2026)
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "CHANNEL", "class_name": "Channel" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      // the aether (11/07/2026, src/aether.ts): one room for every outstation and visitor, one object for the relay
      { "name": "AETHER", "class_name": "Aether" },
      // your year (11/10/2026, src/record.ts): each channel's encrypted record and public summary, apart from its channel
      { "name": "RECORD", "class_name": "Records" },
      // the lookups (11/10/2026, src/lookup.ts, src/lookups.ts): Wise Old Man, RuneProfile and the icons, one shared copy
      { "name": "LOOKUPS", "class_name": "Lookups" }
    ]
  },
  // the clips on players' Outside pages (src/clips.ts): made once with `npx wrangler r2 bucket create outside-clips`
  "r2_buckets": [
    { "binding": "CLIPS", "bucket_name": "outside-clips" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Channel", "Directory"] },
    { "tag": "v2", "new_sqlite_classes": ["Aether"] },
    { "tag": "v3", "new_sqlite_classes": ["Records"] },
    { "tag": "v4", "new_sqlite_classes": ["Lookups"] }
  ],
  // the almanac (11/09/2026, src/almanac.ts): every 5 minutes the Directory asks whichever of its sources is due (the
  // world list each time, Jagex's news every 20 minutes, the Wiki's prices about once a day, its names once a day)
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "MAX_VIEWERS": "0",
    // the oldest client let in ("" lets every version in): raise it when the protocol changes in a way older
    // clients can't follow; they're told to get a newer one (4026) instead of trying again
    // (11/17/2026, Jace: "nobody is left on v0.1.x. you may set the minimum to 0.2.0": set once v0.2.0's release is
    // up, so whoever's told to update finds it)
    "MIN_CLIENT": "0.2.0",
    // recorded fights on players' pages (src/fights.ts, 11/20/2026), each one Jace's call (ghillie's lab): FIGHTS "on" opens
    // them (anything else: off, every /fights route 404s and the page shows nothing); FIGHTS_PUBLIC "1" shows a new fight
    // to anyone unless its player says otherwise ("0": kept to themselves until they show it); FIGHTS_MOST a page's fights
    // at most, the oldest going first; FIGHTS_DAYS how long each is kept ("0": until its player takes it down)
    "FIGHTS": "off",
    "FIGHTS_PUBLIC": "0",
    "FIGHTS_MOST": "20",
    "FIGHTS_DAYS": "30"
  },
  // (11/07/2026: every message a transmitting outstation sends is an invocation, and each was logged: an hour or two
  // at 60 a second used the free plan's whole day of logs. One in a hundred is plenty to look into a fault.)
  "observability": { "enabled": true, "head_sampling_rate": 0.01 }
}
